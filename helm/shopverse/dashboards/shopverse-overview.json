          "expr": "sum by (service) (rate(http_request_duration_seconds_count{namespace=~\"$namespace\",service=~\"$service\",status_code=~\"5..\"}[$__rate_interval])) / sum by (service) (rate(http_request_duration_seconds_count{namespace=~\"$namespace\",service=~\"$service\"}[$__rate_interval]))",
