            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(shopverse_payments_total{namespace=~\"$namespace\",status=\"FAILED\"}[1h])) / sum(rate(shopverse_payments_total{namespace=~\"$namespace\"}[1h]))",
          "instant": true
